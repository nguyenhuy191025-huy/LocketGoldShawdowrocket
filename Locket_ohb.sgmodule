#!name = Locket Gold Personal
#!desc = Locket Gold hosted on my own GitHub

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/nguyenhuy191025-huy/LocketGoldShawdowrocket/main/Locket_.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/nguyenhuy191025-huy/LocketGoldShawdowrocket/main/deleteHeader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
